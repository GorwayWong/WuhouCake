{
  auto_https off
  admin localhost:2019
  servers {
    timeouts {
      read_header 5s
      read_body 30s
      idle 30s
    }
  }
  default_sni {$PUBLIC_IP}
}

http://{$PUBLIC_IP} {
  handle /.well-known/acme-challenge/* {
    root * /var/www/acme
    file_server
  }
  handle {
    redir https://{$PUBLIC_IP}{uri} 308
  }
}

https://{$PUBLIC_IP} {
  tls /etc/letsencrypt/live/{$PUBLIC_IP}/fullchain.pem /etc/letsencrypt/live/{$PUBLIC_IP}/privkey.pem
  encode zstd gzip
  header X-Content-Type-Options nosniff
  header Referrer-Policy same-origin
  @upload {
    path /api/orders/*/images /api/order-packages /api/order-packages/*
    header Content-Type multipart/form-data*
  }
  @jsonWrite {
    path /api/*
    method POST PUT PATCH
    header Content-Type application/json*
  }
  request_body @upload {
    max_size 65MiB
  }
  request_body @jsonWrite {
    max_size 1MiB
  }
  handle /api/* {
    reverse_proxy app:8080 {
      transport http {
        dial_timeout 2s
        response_header_timeout 90s
      }
    }
  }
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
