COMPOSE_PROJECT_NAME=wuhoucake-prod
POSTGRES_DB=wuhoucake
POSTGRES_USER=wuhoucake
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SPRING_PROFILES_ACTIVE=prod
# Direct JVM configuration; app Compose generates these values from POSTGRES_* and REDIS_PASSWORD.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/wuhoucake
SPRING_DATASOURCE_USERNAME=wuhoucake
SPRING_DATASOURCE_PASSWORD=
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
APP_IMAGE=
APP_PORT=8080
DB_POOL_MAX_SIZE=5
IDENTITY_KEY_DIR=
IDENTITY_PRIVATE_KEY=
IDENTITY_PUBLIC_KEY=
CUSTOMER_ENTRY_PUBLIC_ORIGIN=
CUSTOMER_ENTRY_PER_MINUTE=10
CUSTOMER_ENTRY_PER_HOUR=100
CUSTOMER_ENTRY_MAX_BODY_BYTES=131072
# Exact IP addresses of trusted reverse proxies, comma-separated. Empty means ignore forwarded headers.
CUSTOMER_ENTRY_TRUSTED_PROXIES=

# Dedicated infrastructure resource budgets. Redis maxmemory excludes some runtime allocations.
POSTGRES_MEM_LIMIT=256m
POSTGRES_CPUS=0.75
POSTGRES_PIDS_LIMIT=64
POSTGRES_MAX_CONNECTIONS=24
POSTGRES_SHARED_BUFFERS=64MB
POSTGRES_WORK_MEM=2MB
POSTGRES_TEMP_FILE_LIMIT=64MB
REDIS_MEM_LIMIT=96m
REDIS_CPUS=0.35
REDIS_PIDS_LIMIT=32
REDIS_MAXMEMORY=32mb

# Pre-mounted disk filesystem, writable by the non-root application UID/GID.
APP_TEMP_DIR=/srv/wuhoucake-scratch
