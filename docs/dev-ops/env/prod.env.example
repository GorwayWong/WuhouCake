COMPOSE_PROJECT_NAME=wuhoucake-prod
POSTGRES_DB=wuhoucake
POSTGRES_USER=wuhoucake
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SPRING_PROFILES_ACTIVE=prod
# Direct JVM configuration; app Compose generates these values from POSTGRES_* and REDIS_PASSWORD.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/wuhoucake
SPRING_DATASOURCE_USERNAME=wuhoucake
SPRING_DATASOURCE_PASSWORD=
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
APP_IMAGE=
APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
DB_POOL_MAX_SIZE=10
JAVA_TOOL_OPTIONS=
IDENTITY_KEY_DIR=
IDENTITY_PRIVATE_KEY=
IDENTITY_PUBLIC_KEY=
