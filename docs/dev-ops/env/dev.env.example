COMPOSE_PROJECT_NAME=wuhoucake-dev
POSTGRES_DB=wuhoucake
POSTGRES_USER=wuhoucake
POSTGRES_PASSWORD=wuhoucake_dev_password
POSTGRES_PORT=5432
REDIS_PASSWORD=wuhoucake_dev_redis_password
REDIS_PORT=6379
SPRING_PROFILES_ACTIVE=dev
# Host JVM configuration; app Compose uses postgres/redis service names.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/wuhoucake
SPRING_DATASOURCE_USERNAME=wuhoucake
SPRING_DATASOURCE_PASSWORD=wuhoucake_dev_password
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=wuhoucake_dev_redis_password
APP_IMAGE=wuhoucake-bootstrap:local
APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
DB_POOL_MAX_SIZE=10
